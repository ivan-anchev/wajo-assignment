# Provider and model for every LLM call: anthropic:<model>, openai:<model>, or google:<model>
MODEL=anthropic:claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Storage and simulated inbox (defaults shown)
AGENT_DB=agent.db
# Unset, the CLI decides fixtures/inbox and the TUI delivers from scenarios/, one email per n.
# INBOX_DIR=fixtures/inbox
CONTACTS=fixtures/contacts.json
